<?xml version="1.0" encoding="UTF-8"?>
<!-- A hand-written PowerCenter-style export used to smoke-test the converter.
     It reproduces the shape of the dbt jaffle_shop `customers` model: three
     sources, two aggregations, and joins fanning back into one final select.
     Real exports carry many more attributes; only the ones the converter reads
     are present here. -->
<POWERMART REPOSITORY_VERSION="182">
  <REPOSITORY NAME="repo_dev">
    <FOLDER NAME="CUSTOMER_MART">

      <!-- ============================ definitions ======================= -->

      <TRANSFORMATION NAME="SQ_CUSTOMERS" TYPE="Source Qualifier"/>
      <TRANSFORMATION NAME="SQ_ORDERS" TYPE="Source Qualifier"/>
      <TRANSFORMATION NAME="SQ_PAYMENTS" TYPE="Source Qualifier"/>

      <TRANSFORMATION NAME="AGG_CUSTOMER_ORDERS" TYPE="Aggregator">
        <TRANSFORMFIELD NAME="CUSTOMER_ID" DATATYPE="integer"
                        PORTTYPE="INPUT/OUTPUT" GROUPBY="YES"/>
        <TRANSFORMFIELD NAME="ORDER_ID" DATATYPE="integer" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="ORDER_DATE" DATATYPE="date" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="FIRST_ORDER" DATATYPE="date" PORTTYPE="OUTPUT"
                        EXPRESSION="MIN(ORDER_DATE)"/>
        <TRANSFORMFIELD NAME="MOST_RECENT_ORDER" DATATYPE="date" PORTTYPE="OUTPUT"
                        EXPRESSION="MAX(ORDER_DATE)"/>
        <TRANSFORMFIELD NAME="NUMBER_OF_ORDERS" DATATYPE="integer" PORTTYPE="OUTPUT"
                        EXPRESSION="COUNT(ORDER_ID)"/>
      </TRANSFORMATION>

      <TRANSFORMATION NAME="JNR_PAYMENT_ORDERS" TYPE="Joiner">
        <TRANSFORMFIELD NAME="CUSTOMER_ID" DATATYPE="integer" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="AMOUNT" DATATYPE="decimal" PORTTYPE="INPUT/OUTPUT"/>
        <TABLEATTRIBUTE NAME="Join Type" VALUE="Master Outer Join"/>
        <TABLEATTRIBUTE NAME="Join Condition" VALUE="ORDER_ID = ORDER_ID"/>
      </TRANSFORMATION>

      <TRANSFORMATION NAME="AGG_CUSTOMER_PAYMENTS" TYPE="Aggregator">
        <TRANSFORMFIELD NAME="CUSTOMER_ID" DATATYPE="integer"
                        PORTTYPE="INPUT/OUTPUT" GROUPBY="YES"/>
        <TRANSFORMFIELD NAME="AMOUNT" DATATYPE="decimal" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="TOTAL_AMOUNT" DATATYPE="decimal" PORTTYPE="OUTPUT"
                        EXPRESSION="SUM(AMOUNT)"/>
      </TRANSFORMATION>

      <TRANSFORMATION NAME="JNR_ORDERS_JOIN" TYPE="Joiner">
        <TRANSFORMFIELD NAME="CUSTOMER_ID" DATATYPE="integer" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="FIRST_NAME" DATATYPE="string" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="LAST_NAME" DATATYPE="string" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="FIRST_ORDER" DATATYPE="date" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="MOST_RECENT_ORDER" DATATYPE="date" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="NUMBER_OF_ORDERS" DATATYPE="integer" PORTTYPE="INPUT/OUTPUT"/>
        <TABLEATTRIBUTE NAME="Join Type" VALUE="Master Outer Join"/>
        <TABLEATTRIBUTE NAME="Join Condition" VALUE="CUSTOMER_ID = CUSTOMER_ID"/>
      </TRANSFORMATION>

      <TRANSFORMATION NAME="JNR_PAYMENTS_JOIN" TYPE="Joiner">
        <TRANSFORMFIELD NAME="CUSTOMER_ID" DATATYPE="integer" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="FIRST_NAME" DATATYPE="string" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="LAST_NAME" DATATYPE="string" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="FIRST_ORDER" DATATYPE="date" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="MOST_RECENT_ORDER" DATATYPE="date" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="NUMBER_OF_ORDERS" DATATYPE="integer" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="TOTAL_AMOUNT" DATATYPE="decimal" PORTTYPE="INPUT/OUTPUT"/>
        <TABLEATTRIBUTE NAME="Join Type" VALUE="Master Outer Join"/>
        <TABLEATTRIBUTE NAME="Join Condition" VALUE="CUSTOMER_ID = CUSTOMER_ID"/>
      </TRANSFORMATION>

      <TRANSFORMATION NAME="EXP_CUSTOMERS" TYPE="Expression">
        <TRANSFORMFIELD NAME="CUSTOMER_ID" DATATYPE="integer" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="FIRST_NAME" DATATYPE="string" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="LAST_NAME" DATATYPE="string" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="FIRST_ORDER" DATATYPE="date" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="MOST_RECENT_ORDER" DATATYPE="date" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="NUMBER_OF_ORDERS" DATATYPE="integer" PORTTYPE="INPUT/OUTPUT"/>
        <TRANSFORMFIELD NAME="TOTAL_AMOUNT" DATATYPE="decimal" PORTTYPE="INPUT"/>
        <TRANSFORMFIELD NAME="CUSTOMER_LIFETIME_VALUE" DATATYPE="decimal"
                        PORTTYPE="OUTPUT" EXPRESSION="NVL(TOTAL_AMOUNT, 0)"/>
        <TRANSFORMFIELD NAME="CUSTOMER_STATUS" DATATYPE="string" PORTTYPE="OUTPUT"
                        EXPRESSION="IIF(NUMBER_OF_ORDERS &gt; 0, 'active', 'prospect')"/>
        <TRANSFORMFIELD NAME="FIRST_ORDER_MONTH" DATATYPE="date" PORTTYPE="OUTPUT"
                        EXPRESSION="TRUNC(FIRST_ORDER, 'MM')"/>
        <TRANSFORMFIELD NAME="DAYS_SINCE_LAST_ORDER" DATATYPE="integer" PORTTYPE="OUTPUT"
                        EXPRESSION="DATE_DIFF(SYSDATE, MOST_RECENT_ORDER, 'DD')"/>
      </TRANSFORMATION>

      <!-- ============================== mapping ========================= -->

      <MAPPING NAME="m_customers" DESCRIPTION="Customer dimension with order and payment rollups">

        <INSTANCE NAME="SRC_CUSTOMERS" TYPE="SOURCE" TRANSFORMATION_NAME="customers"/>
        <INSTANCE NAME="SRC_ORDERS" TYPE="SOURCE" TRANSFORMATION_NAME="orders"/>
        <INSTANCE NAME="SRC_PAYMENTS" TYPE="SOURCE" TRANSFORMATION_NAME="payments"/>

        <INSTANCE NAME="SQ_CUSTOMERS" TYPE="TRANSFORMATION"
                  TRANSFORMATION_NAME="SQ_CUSTOMERS" TRANSFORMATION_TYPE="Source Qualifier"/>
        <INSTANCE NAME="SQ_ORDERS" TYPE="TRANSFORMATION"
                  TRANSFORMATION_NAME="SQ_ORDERS" TRANSFORMATION_TYPE="Source Qualifier"/>
        <INSTANCE NAME="SQ_PAYMENTS" TYPE="TRANSFORMATION"
                  TRANSFORMATION_NAME="SQ_PAYMENTS" TRANSFORMATION_TYPE="Source Qualifier"/>

        <INSTANCE NAME="AGG_CUSTOMER_ORDERS" TYPE="TRANSFORMATION"
                  TRANSFORMATION_NAME="AGG_CUSTOMER_ORDERS" TRANSFORMATION_TYPE="Aggregator"/>
        <INSTANCE NAME="JNR_PAYMENT_ORDERS" TYPE="TRANSFORMATION"
                  TRANSFORMATION_NAME="JNR_PAYMENT_ORDERS" TRANSFORMATION_TYPE="Joiner"/>
        <INSTANCE NAME="AGG_CUSTOMER_PAYMENTS" TYPE="TRANSFORMATION"
                  TRANSFORMATION_NAME="AGG_CUSTOMER_PAYMENTS" TRANSFORMATION_TYPE="Aggregator"/>
        <INSTANCE NAME="JNR_ORDERS_JOIN" TYPE="TRANSFORMATION"
                  TRANSFORMATION_NAME="JNR_ORDERS_JOIN" TRANSFORMATION_TYPE="Joiner"/>
        <INSTANCE NAME="JNR_PAYMENTS_JOIN" TYPE="TRANSFORMATION"
                  TRANSFORMATION_NAME="JNR_PAYMENTS_JOIN" TRANSFORMATION_TYPE="Joiner"/>
        <INSTANCE NAME="EXP_CUSTOMERS" TYPE="TRANSFORMATION"
                  TRANSFORMATION_NAME="EXP_CUSTOMERS" TRANSFORMATION_TYPE="Expression"/>

        <INSTANCE NAME="TGT_DIM_CUSTOMERS" TYPE="TARGET" TRANSFORMATION_NAME="dim_customers"/>

        <!-- sources into their qualifiers -->
        <CONNECTOR FROMINSTANCE="SRC_CUSTOMERS" FROMFIELD="CUSTOMER_ID"
                   TOINSTANCE="SQ_CUSTOMERS" TOFIELD="CUSTOMER_ID"/>
        <CONNECTOR FROMINSTANCE="SRC_ORDERS" FROMFIELD="ORDER_ID"
                   TOINSTANCE="SQ_ORDERS" TOFIELD="ORDER_ID"/>
        <CONNECTOR FROMINSTANCE="SRC_PAYMENTS" FROMFIELD="PAYMENT_ID"
                   TOINSTANCE="SQ_PAYMENTS" TOFIELD="PAYMENT_ID"/>

        <!-- orders -> per-customer order rollup -->
        <CONNECTOR FROMINSTANCE="SQ_ORDERS" FROMFIELD="CUSTOMER_ID"
                   TOINSTANCE="AGG_CUSTOMER_ORDERS" TOFIELD="CUSTOMER_ID"/>
        <CONNECTOR FROMINSTANCE="SQ_ORDERS" FROMFIELD="ORDER_ID"
                   TOINSTANCE="AGG_CUSTOMER_ORDERS" TOFIELD="ORDER_ID"/>
        <CONNECTOR FROMINSTANCE="SQ_ORDERS" FROMFIELD="ORDER_DATE"
                   TOINSTANCE="AGG_CUSTOMER_ORDERS" TOFIELD="ORDER_DATE"/>

        <!-- payments joined to orders, then rolled up per customer -->
        <CONNECTOR FROMINSTANCE="SQ_PAYMENTS" FROMFIELD="AMOUNT"
                   TOINSTANCE="JNR_PAYMENT_ORDERS" TOFIELD="AMOUNT"/>
        <CONNECTOR FROMINSTANCE="SQ_ORDERS" FROMFIELD="CUSTOMER_ID"
                   TOINSTANCE="JNR_PAYMENT_ORDERS" TOFIELD="CUSTOMER_ID"/>
        <CONNECTOR FROMINSTANCE="JNR_PAYMENT_ORDERS" FROMFIELD="CUSTOMER_ID"
                   TOINSTANCE="AGG_CUSTOMER_PAYMENTS" TOFIELD="CUSTOMER_ID"/>
        <CONNECTOR FROMINSTANCE="JNR_PAYMENT_ORDERS" FROMFIELD="AMOUNT"
                   TOINSTANCE="AGG_CUSTOMER_PAYMENTS" TOFIELD="AMOUNT"/>

        <!-- customers joined to the order rollup -->
        <CONNECTOR FROMINSTANCE="SQ_CUSTOMERS" FROMFIELD="CUSTOMER_ID"
                   TOINSTANCE="JNR_ORDERS_JOIN" TOFIELD="CUSTOMER_ID"/>
        <CONNECTOR FROMINSTANCE="SQ_CUSTOMERS" FROMFIELD="FIRST_NAME"
                   TOINSTANCE="JNR_ORDERS_JOIN" TOFIELD="FIRST_NAME"/>
        <CONNECTOR FROMINSTANCE="SQ_CUSTOMERS" FROMFIELD="LAST_NAME"
                   TOINSTANCE="JNR_ORDERS_JOIN" TOFIELD="LAST_NAME"/>
        <CONNECTOR FROMINSTANCE="AGG_CUSTOMER_ORDERS" FROMFIELD="FIRST_ORDER"
                   TOINSTANCE="JNR_ORDERS_JOIN" TOFIELD="FIRST_ORDER"/>
        <CONNECTOR FROMINSTANCE="AGG_CUSTOMER_ORDERS" FROMFIELD="MOST_RECENT_ORDER"
                   TOINSTANCE="JNR_ORDERS_JOIN" TOFIELD="MOST_RECENT_ORDER"/>
        <CONNECTOR FROMINSTANCE="AGG_CUSTOMER_ORDERS" FROMFIELD="NUMBER_OF_ORDERS"
                   TOINSTANCE="JNR_ORDERS_JOIN" TOFIELD="NUMBER_OF_ORDERS"/>

        <!-- final projection -->
        <CONNECTOR FROMINSTANCE="JNR_ORDERS_JOIN" FROMFIELD="CUSTOMER_ID"
                   TOINSTANCE="JNR_PAYMENTS_JOIN" TOFIELD="CUSTOMER_ID"/>
        <CONNECTOR FROMINSTANCE="JNR_PAYMENTS_JOIN" FROMFIELD="CUSTOMER_ID"
                   TOINSTANCE="EXP_CUSTOMERS" TOFIELD="CUSTOMER_ID"/>
        <CONNECTOR FROMINSTANCE="JNR_ORDERS_JOIN" FROMFIELD="FIRST_NAME"
                   TOINSTANCE="JNR_PAYMENTS_JOIN" TOFIELD="FIRST_NAME"/>
        <CONNECTOR FROMINSTANCE="JNR_PAYMENTS_JOIN" FROMFIELD="FIRST_NAME"
                   TOINSTANCE="EXP_CUSTOMERS" TOFIELD="FIRST_NAME"/>
        <CONNECTOR FROMINSTANCE="JNR_ORDERS_JOIN" FROMFIELD="LAST_NAME"
                   TOINSTANCE="JNR_PAYMENTS_JOIN" TOFIELD="LAST_NAME"/>
        <CONNECTOR FROMINSTANCE="JNR_PAYMENTS_JOIN" FROMFIELD="LAST_NAME"
                   TOINSTANCE="EXP_CUSTOMERS" TOFIELD="LAST_NAME"/>
        <CONNECTOR FROMINSTANCE="JNR_ORDERS_JOIN" FROMFIELD="FIRST_ORDER"
                   TOINSTANCE="JNR_PAYMENTS_JOIN" TOFIELD="FIRST_ORDER"/>
        <CONNECTOR FROMINSTANCE="JNR_PAYMENTS_JOIN" FROMFIELD="FIRST_ORDER"
                   TOINSTANCE="EXP_CUSTOMERS" TOFIELD="FIRST_ORDER"/>
        <CONNECTOR FROMINSTANCE="JNR_ORDERS_JOIN" FROMFIELD="MOST_RECENT_ORDER"
                   TOINSTANCE="JNR_PAYMENTS_JOIN" TOFIELD="MOST_RECENT_ORDER"/>
        <CONNECTOR FROMINSTANCE="JNR_PAYMENTS_JOIN" FROMFIELD="MOST_RECENT_ORDER"
                   TOINSTANCE="EXP_CUSTOMERS" TOFIELD="MOST_RECENT_ORDER"/>
        <CONNECTOR FROMINSTANCE="JNR_ORDERS_JOIN" FROMFIELD="NUMBER_OF_ORDERS"
                   TOINSTANCE="JNR_PAYMENTS_JOIN" TOFIELD="NUMBER_OF_ORDERS"/>
        <CONNECTOR FROMINSTANCE="JNR_PAYMENTS_JOIN" FROMFIELD="NUMBER_OF_ORDERS"
                   TOINSTANCE="EXP_CUSTOMERS" TOFIELD="NUMBER_OF_ORDERS"/>
        <CONNECTOR FROMINSTANCE="AGG_CUSTOMER_PAYMENTS" FROMFIELD="TOTAL_AMOUNT"
                   TOINSTANCE="JNR_PAYMENTS_JOIN" TOFIELD="TOTAL_AMOUNT"/>
        <CONNECTOR FROMINSTANCE="JNR_PAYMENTS_JOIN" FROMFIELD="TOTAL_AMOUNT"
                   TOINSTANCE="EXP_CUSTOMERS" TOFIELD="TOTAL_AMOUNT"/>

        <CONNECTOR FROMINSTANCE="EXP_CUSTOMERS" FROMFIELD="CUSTOMER_ID"
                   TOINSTANCE="TGT_DIM_CUSTOMERS" TOFIELD="CUSTOMER_ID"/>

      </MAPPING>
    </FOLDER>
  </REPOSITORY>
</POWERMART>
